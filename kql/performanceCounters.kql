let startTime = ago(60m);
let endTime   = now();
 
// Exceptions
let ex = exceptions
| where timestamp between (startTime .. endTime)
| extend isOOM = type == "System.OutOfMemoryException" or innermostMessage has "OutOfMemoryException"
| extend isSocket = type has "SocketException" or innermostMessage has "SocketException"
| summarize oom = countif(isOOM), sockets = countif(isSocket)
| extend key = 1;
 
// Requests
let req = requests
| where timestamp between (startTime .. endTime)
| summarize p95 = percentile(duration, 95), 
            p99 = percentile(duration, 99), 
            reqCount = count(), 
            failReq = countif(success == false)
| extend key = 1;
 
// Dependencies
let dep = dependencies
| where timestamp between (startTime .. endTime)
| summarize depTotal   = sum(itemCount), 
            depFail    = sumif(itemCount, success == false), 
            depTimeout = sumif(itemCount, resultCode == "Timeout" or target has "timeout")
| extend key = 1;
 
// CPU and Memory
let sysMetrics = performanceCounters
| where timestamp between (startTime .. endTime)
| where name == "% Processor Time" or name == "Available MBytes"
| summarize avgCPU = avgif(value, name == "% Processor Time"),
            avgMemMB = avgif(value, name == "Available MBytes")
| extend key = 1;
 
// Combine all
ex
| join kind=inner req on key
| join kind=inner dep on key
| join kind=inner sysMetrics on key
| extend failRate = todouble(failReq) / todouble(reqCount + 1e-6)
| project features = pack_all()